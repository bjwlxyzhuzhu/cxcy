# 复制为 .env.local 并填入真实值（.env.local 不提交）

# —— 数据库：SQLite 单文件（Node 内置 node:sqlite，需 Node ≥ 22.13，推荐 24+）——
# 相对路径按启动目录解析；Docker 里映射到数据卷 /app/data
DATABASE_URL=file:./data/app.db

# —— 登录会话签名密钥：至少 32 个随机字符，泄露后需更换（更换会让所有人重新登录）——
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# 会话有效期（天），默认 7
SESSION_MAX_AGE_DAYS=7
# 会话 cookie 是否加 Secure：留空=按请求是否 https 自动判断；1=强制；0=关闭（纯 http 内网访问时）
SESSION_COOKIE_SECURE=

# —— 对话模型：DeepSeek（数据只发往国内模型服务）——
CHAT_BASE_URL=https://api.deepseek.com
CHAT_API_KEY=sk-xxx                                # 仅服务端
CHAT_MODEL=deepseek-flash                          # DeepSeek V4.1 Flash 的官方模型名

# —— APIMart（境外网关，可选）：只用于配图与知识库向量；可留空，相关功能自动降级 ——
APIMART_BASE_URL=https://api.apimart.ai/v1
APIMART_API_KEY=
IMAGE_MODEL=gpt-image-2
EMBED_MODEL=text-embedding-3-small


# 首页实时动态墙：平台还没有真实数据时是否显示带「演示数据」标注的示例条目（1=开；正式评审前务必置空）
WALL_DEMO=
