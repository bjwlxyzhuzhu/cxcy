# 复制为 .env.local 并填入真实值（.env.local 不提交）
DATABASE_URL=postgresql://cxcy:change-me@localhost:5432/cxcy
SESSION_SECRET=change-me-to-a-random-value-at-least-32-characters
APIMART_BASE_URL=https://api.apimart.ai/v1
APIMART_API_KEY=sk-xxx                             # 仅服务端
CHAT_MODEL=gpt-4o
IMAGE_MODEL=gpt-image-2
EMBED_MODEL=text-embedding-3-small

# 商业级 PPT 引擎（开源 Presenton，github.com/presenton/presenton；不配则 PPT 页只有轻量导出）
PPTGEN_BASE_URL=http://localhost:5001      # 服务端调用引擎的地址
PPTGEN_PUBLIC_URL=                          # 浏览器访问引擎的地址（默认同上；上生产填反代域名）
PPTGEN_AUTH=                                # 可选 Basic 认证 user:pass

# 首页实时动态墙：平台还没有真实数据时是否显示带「演示数据」标注的示例条目（1=开；正式评审前务必置空）
WALL_DEMO=
